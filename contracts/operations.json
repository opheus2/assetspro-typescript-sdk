          "description": "Brand-role ULID.",
          "example": "{{brand_role_id}}"
        },
        {
          "name": "category_ids[]",
          "description": "Repeat this key for multiple IDs, maximum 50.",
          "example": "{{category_id}}"
        },
        {
          "name": "tag_ids[]",
          "description": "Repeat this key for multiple IDs, maximum 50.",
          "example": "{{tag_id}}"
        },
        {
          "name": "collection_ids[]",
          "description": "Repeat this key for multiple IDs, maximum 50.",
          "example": "{{collection_id}}"
        },
        {
          "name": "media_type",
          "description": "image or document.",
          "example": "image"
        },
        {
          "name": "extension",
          "description": "Exact active-revision extension, without a dot; maximum 10 characters.",
          "example": "png"
        },
        {
          "name": "uploaded_by",
          "description": "Uploader integer user ID, minimum 1.",
          "example": "{{user_id}}"
        },
        {
          "name": "created_from",
          "description": "Inclusive YYYY-MM-DD start date.",
          "example": "2026-01-01"
        },
        {
          "name": "created_to",
          "description": "Inclusive YYYY-MM-DD end date, on or after created_from.",
          "example": "2026-12-31"
        },
        {
          "name": "min_width",
          "description": "Active-revision width lower bound, integer >= 1.",
          "example": "800"
        },
        {
          "name": "max_width",
          "description": "Active-revision width upper bound, integer >= 1.",
          "example": "4000"
        },
        {
          "name": "min_height",
          "description": "Active-revision height lower bound, integer >= 1.",
          "example": "600"
        },
        {
          "name": "max_height",
          "description": "Active-revision height upper bound, integer >= 1.",
          "example": "4000"
        },
        {
          "name": "status",
          "description": "processing, ready, or failed.",
          "example": "ready"
        },
        {
          "name": "sort",
          "description": "newest (default), oldest, name, or name_desc.",
          "example": "newest"
        },
        {
          "name": "view",
          "description": "grid or list; accepted UI preference, does not change the data query.",
          "example": "grid"
        },
        {
          "name": "archived",
          "description": "Boolean: select archived assets.",
          "example": "1"
        },
        {
          "name": "trash",
          "description": "Boolean: select trashed assets; requires assets.delete.",
          "example": "1"
        },
        {
          "name": "per_page",
          "description": "Integer 1–100; default 48.",
          "example": "48"
        },
        {
          "name": "cursor",
          "description": "Opaque cursor from the previous response; maximum 2048 characters.",
          "example": "{{asset_cursor}}"
        }
