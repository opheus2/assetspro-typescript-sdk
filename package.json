{
    "name": "@assetspro/typescript-sdk",
    "version": "1.0.1",
    "description": "Server-side TypeScript client for the Assets Pro authenticated API",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "src",
        "examples"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "node --test test/*.test.mjs",
        "test:bun": "bun test test/*.test.mjs",
        "prepack": "bun run build"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "bun": ">=1.3",
        "node": ">=22"
    }
}